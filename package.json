{
  "name": "discord-claude-extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A small Chrome-to-Claude Code bridge for Discord Web source messages.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs --typecheck",
    "test": "node scripts/test.mjs",
    "bridge:install": "node scripts/service.mjs install",
    "bridge:uninstall": "node scripts/service.mjs uninstall",
    "bridge:status": "node scripts/service.mjs status",
    "bridge:setup": "node scripts/setup.mjs",
    "bridge:export-extension": "node scripts/service.mjs export-extension",
    "bridge:doctor": "node scripts/doctor.mjs",
    "bridge:start": "node bridge/src/index.js",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
